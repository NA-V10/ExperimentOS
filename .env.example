# ─── NVIDIA Nemotron via Nebius Token Factory (OpenAI-compatible) ───────────────────────
# Get a key at https://tokenfactory.nebius.com. Copy model IDs from the Token Factory model
# catalog (NVIDIA → Nemotron). Model names are never hard-coded in the application.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Stronger reasoning model — hypothesis, experiment design, code generation, analysis, next experiment
NEBIUS_MODEL=
# Optional smaller/faster model — question parsing, research summarisation (defaults to NEBIUS_MODEL)
NEBIUS_FAST_MODEL=
# Without a key, run with the deterministic offline planner (clearly labelled in the UI) instead of refusing.
ALLOW_OFFLINE_FALLBACK=true
# Replay identical Nemotron requests from backend/.llm_cache/ to save Token Factory usage
LLM_CACHE=true
# Usage guardrails (protect a trial plan). 0 disables a limit.
LLM_DAILY_TOKEN_BUDGET=300000
LLM_MAX_CALLS_PER_EXPERIMENT=20
MAX_CONCURRENT_EXPERIMENTS=2
EXPERIMENT_RATE_LIMIT_PER_MINUTE=6

# ─── Tavily (optional research discovery) ─────────────────────────────────────────────────
TAVILY_API_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./experimentos.db

# ─── Execution: local | nebius ──────────────────────────────────────────────────────────────
EXECUTION_MODE=local
EXECUTION_TIMEOUT_SECONDS=240
EXECUTION_MEMORY_MB=1024
MAX_RUNS_PER_EXPERIMENT=12

# Nebius AI Cloud — Serverless AI Jobs (used when EXECUTION_MODE=nebius; requires the `nebius` CLI)
NEBIUS_CLI=nebius
NEBIUS_PROJECT_ID=
NEBIUS_JOB_IMAGE=
NEBIUS_JOB_PLATFORM=cpu-d3
NEBIUS_JOB_PRESET=4vcpu-16gb
NEBIUS_JOB_TIMEOUT=1h
NEBIUS_JOB_FALLBACK_LOCAL=true

# ─── API / frontend ─────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
